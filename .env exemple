# Clé API obtenue sur https://console.groq.com/
GROQ_API_KEY=

# Langue de sortie par défaut (fr ou en) si une requête n'envoie pas le
# champ `lang` (ex. anciens clients PWA en cache). Whisper auto-détecte
# toujours la langue parlée dans l'audio, indépendamment de ce réglage.
LANGUAGE=fr

#Port
PORT=5000

# Origines autorisées pour le frontend PWA séparé (CORS), séparées par des virgules.
# Défaut : https://parseandcut.alithiel31.dev (same-origin en prod, nginx sert le
# frontend ET reverse-proxy /api/* vers ce backend). Surcharger en dev local avec
# l'origine Vite (:5173 qui tape sur uvicorn sur :5000).
CORS_ORIGINS=http://localhost:5173

# Taille max d'upload en Mo (défaut 100, alignée sur le plafond de Cloudflare
# pour les requêtes proxyées — Free/Pro ; en plus des 500 Mo côté nginx).
MAX_UPLOAD_SIZE_MB=100

# Limite de requêtes sur /process, format "N/period" (ex: "5/minute").
RATE_LIMIT_PROCESS=5/minute